# MongoDB Atlas connection string (required for cloud sync and publishing)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
PINCODE_DATABASE=pincode

# Generate a long random secret. Authentication integration must be completed
# before treating the API as production-ready.
PINCODE_SECRET=replace-with-a-long-random-secret

# Add the exact frontend origins used by your deployment, comma-separated.
PINCODE_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173

# Optional future AI provider key; do not put provider keys in frontend code.
PINCODE_AI_API_KEY=
