{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PinCode desktop window with user-selected workspace filesystem access",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "core:path:default"
  ]
}
